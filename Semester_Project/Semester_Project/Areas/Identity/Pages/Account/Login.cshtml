@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    ViewData["HideNavBar"] = true;
    ViewData["BodyClass"] = "login-page";
}

<!-- Link to new Premium CSS -->
<link rel="stylesheet" href="~/css/login.css" />

<div class="auth-wrapper">
    <div class="card-glass">
        <div class="auth-header">
            <h1>Welcome Back</h1>
            <p>Enter your credentials to access the dashboard</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email Address</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">
                        Remember me
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-auth">Log In</button>
        </form>

        <div class="divider">
            <span>OR</span>
        </div>

        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-auth btn-auth-secondary">
            Create New Account
        </a>

        <div class="auth-links mt-4">
            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
