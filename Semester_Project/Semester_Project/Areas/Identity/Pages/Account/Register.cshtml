@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    ViewData["HideNavBar"] = true;
}

<style>
    /* Scoped body style for background only */
    body {
        margin: 0;
        padding: 0;
        background: url('/images/background.jpg') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', sans-serif;
    }

    .register-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center; /* Center horizontally */
        align-items: center;     /* Center vertically */
        padding: 20px;
    }

    .card-glass {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 2rem 3rem;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    h1, h2, h3, h4, .text-gray-900 {
        color: #fff !important;
        text-align: center;
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .form-control {
        background-color: rgba(255, 255, 255, 0.2) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        height: 50px;
        border-radius: 30px;
        padding-left: 20px;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.7);
    }

    .form-control:focus {
        background-color: rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
    }

    .btn-primary-custom {
        background-color: #4e73df;
        border-color: #4e73df;
        border-radius: 30px;
        height: 50px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-primary-custom:hover {
        background-color: #2e59d9;
        border-color: #2653d4;
        transform: translateY(-2px);
    }

    .text-center a {
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        font-size: 0.9rem;
    }

    .text-center a:hover {
        color: #fff;
        text-decoration: underline;
    }

    hr {
        border-top: 1px solid rgba(255, 255, 255, 0.3);
    }

    .text-danger {
        color: #ffb3b3 !important;
        font-size: 0.85rem;
    }
</style>

<div class="register-wrapper">
    <div class="card-glass">
        <div class="text-center">
            <h1 class="h4 mb-4">Create an Account!</h1>
        </div>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="user">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <div class="form-group mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email Address" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            
            <div class="row mb-3">
                <div class="col-sm-6 mb-3 mb-sm-0">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Repeat Password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                    <div class="col-sm-6 mb-3 mb-sm-0">
                    <input asp-for="Input.City" class="form-control" placeholder="City" />
                    <span asp-validation-for="Input.City" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <input asp-for="Input.State" class="form-control" placeholder="State" />
                    <span asp-validation-for="Input.State" class="text-danger"></span>
                </div>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary-custom btn-block w-100 mb-3">
                Register Account
            </button>
        </form>
        <hr>
        <div class="text-center">
            <a class="small" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account? Login!</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
