@model Semester_Project.Models.ISP_user

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row animate__animated animate__fadeIn">
    @if (Model.IsPaid != true)
    {
        <!-- EXPIRED / PAYMENT PENDING STATE -->
        <div class="col-12 mt-5">
            <div class="card border-0 shadow-lg text-center" style="background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%); border-radius: 20px;">
                <div class="card-body py-5">
                    <div class="mb-4">
                        <div class="icon-circle bg-danger text-white mx-auto d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border-radius: 50%; box-shadow: 0 10px 20px rgba(220, 38, 38, 0.3);">
                            <i class="fas fa-exclamation-triangle fa-3x"></i>
                        </div>
                    </div>
                    <h2 class="text-danger font-weight-bold mb-3">Service Suspended</h2>
                    <h5 class="text-gray-700 mb-4" style="max-width: 600px; margin: 0 auto;">
                        Your subscription for <strong>@(Model.InternetPackage?.PackageName ?? "Internet Plan")</strong> has expired or payment is pending. 
                        Please clear your pending dues to resume high-speed internet services immediately.
                    </h5>
                    
                    <div class="bg-white p-4 rounded-lg shadow-sm d-inline-block mb-4" style="border-radius: 15px;">
                        <div class="text-xs text-uppercase text-gray-500 font-weight-bold tracking-wider">Total Due Amount</div>
                        <div class="display-4 font-weight-bold text-gray-800">@Model.Price.ToString("C")</div>
                    </div>
                    
                    <div>
                         <a asp-action="MakePayment" class="btn btn-danger btn-lg px-5 py-3 shadow-lg" style="border-radius: 50px; font-weight: 700; letter-spacing: 0.5px;">
                            <i class="fas fa-credit-card mr-2"></i> PAY NOW
                        </a>
                        <div class="mt-3">
                            <a asp-controller="Ticket" asp-action="Create" class="text-muted small">Report a billing issue</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ACTIVE STATE (Existing Design Enhanced) -->
        <!-- User Info Card -->
        <div class="col-lg-4 mb-4">
            <div class="card card-custom h-100 shadow-sm border-0">
                <div class="card-body text-center pt-5">
                    <div class="mb-3">
                         <img src="https://ui-avatars.com/api/?name=@Model.Name&background=6366f1&color=fff&size=128" class="rounded-circle shadow-lg" style="width: 100px; height: 100px; border: 4px solid white;">
                    </div>
                    <h3 class="font-weight-bold text-gray-800">@Model.Name</h3>
                    <p class="text-muted mb-4">@Model.Email</p>
                    
                    <div class="text-left bg-light p-3 rounded mb-3">
                        <div class="d-flex align-items-center mb-2">
                             <div class="icon-circle bg-primary text-white mr-3" style="width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-phone fa-sm"></i>
                             </div>
                             <div>
                                 <div class="small text-gray-500">Phone</div>
                                 <div class="font-weight-bold">@Model.Phone</div>
                             </div>
                        </div>
                        <div class="d-flex align-items-center">
                             <div class="icon-circle bg-success text-white mr-3" style="width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-map-marker-alt fa-sm"></i>
                             </div>
                             <div>
                                 <div class="small text-gray-500">Address</div>
                                 <div class="font-weight-bold">@Model.Address</div>
                             </div>
                        </div>
                    </div>
                    
                     <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-outline-primary btn-sm btn-block rounded-pill">Edit Profile</a>
                </div>
            </div>
        </div>

        <!-- Plan & Status Card -->
        <div class="col-lg-8">
            <div class="row">
                <!-- Plan Details -->
                <div class="col-md-6 mb-4">
                    <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; border-radius: 20px;">
                        <div class="card-body position-relative overflow-hidden">
                             <!-- Decorative Circle -->
                             <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
                             
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-uppercase text-white-50 font-weight-bold mb-1" style="font-size: 0.8rem; letter-spacing: 1px;">
                                        Current Plan</div>
                                    <div class="h2 mb-0 font-weight-bold">@(Model.InternetPackage?.PackageName ?? "No Plan")</div>
                                    <div class="mt-3 d-flex align-items-center">
                                        <i class="fas fa-tachometer-alt mr-2 opacity-75"></i>
                                        <span class="font-weight-bold h5 mb-0">@(Model.InternetPackage?.Speed ?? 0) Mbps</span>
                                    </div>
                                    <div class="mt-1 text-white-50 small">High Speed Fiber</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-wifi fa-4x text-white-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Status -->
                <div class="col-md-6 mb-4">
                     <div class="card border-0 shadow-sm h-100" style="border-radius: 20px;">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div>
                                     <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Status</div>
                                     <div class="h4 mb-0 font-weight-bold text-gray-800">
                                          <span class="badge bg-success rounded-pill px-3"><i class="fas fa-check-circle mr-1"></i> Active</span>
                                     </div>
                                </div>
                                <div class="icon-circle bg-light text-success p-3 rounded-circle">
                                     <i class="fas fa-shield-alt fa-2x"></i>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Plan Cost</span>
                                    <span class="font-weight-bold text-dark">@Model.Price.ToString("C")/mo</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                           
                             <div class="text-center mt-4">
                                 <small class="text-muted">Next billing date: <strong>@(DateTime.Now.AddDays(15).ToString("MMM dd, yyyy"))</strong></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-sm mb-4 border-0" style="border-radius: 16px;">
                <div class="card-header py-3 bg-white border-bottom-0">
                    <h6 class="m-0 font-weight-bold text-gray-800">Quick Actions</h6>
                </div>
                <div class="card-body">
                     <div class="row">
                        <div class="col-md-4 mb-2">
                             <a asp-controller="User" asp-action="MyBill" class="btn btn-light btn-block py-3 border hover-lift">
                                <i class="fas fa-file-invoice-dollar text-primary mb-2 d-block fa-2x"></i>
                                <span class="font-weight-bold text-gray-700">View Bill</span>
                            </a>
                        </div>
                        <div class="col-md-4 mb-2">
                            <a asp-controller="Ticket" asp-action="Create" class="btn btn-light btn-block py-3 border hover-lift">
                                <i class="fas fa-headset text-info mb-2 d-block fa-2x"></i>
                                <span class="font-weight-bold text-gray-700">Support Helper</span>
                            </a>
                        </div>
                         <div class="col-md-4 mb-2">
                            <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-light btn-block py-3 border hover-lift">
                                <i class="fas fa-key text-warning mb-2 d-block fa-2x"></i>
                                <span class="font-weight-bold text-gray-700">Security</span>
                            </a>
                        </div>
                     </div>
                </div>
            </div>
        </div>
    }
</div>
