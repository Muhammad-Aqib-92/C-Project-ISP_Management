@model Semester_Project.Models.ISP_user

@{
    ViewData["Title"] = "My Bill";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var paymentHistory = ViewBag.PaymentHistory as List<Semester_Project.Models.PaymentHistory>;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        
        <!-- Current Status -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Current Billing Status</h6>
            </div>
            <div class="card-body text-center">
                @if (Model != null)
                {
                    <h2 class="display-4">@Model.Price.ToString("C")</h2>
                    <p class="mb-4">Current Monthly Due Amount</p>
                    
                    @if (Model.IsPaid == true)
                    {
                        <div class="alert alert-success d-inline-block">
                            <i class="fas fa-check-circle"></i> Paid for this month
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger d-inline-block">
                            <i class="fas fa-exclamation-circle"></i> Payment Pending
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-primary" disabled title="Online payment disabled">Pay Online (Coming Soon)</button>
                        </div>
                    }
                }
                else
                {
                    <p>Billing information unavailable.</p>
                }
            </div>
        </div>

        <!-- Payment History -->
        <div class="card shadow mb-4">
             <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Payment History</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (paymentHistory != null && paymentHistory.Any())
                            {
                                foreach (var payment in paymentHistory)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                                        <td>@payment.Amount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No payment history found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
