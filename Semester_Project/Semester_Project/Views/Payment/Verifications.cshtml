@model IEnumerable<Semester_Project.Models.PaymentVerification>
@{
    ViewData["Title"] = "Payment Verifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card card-custom shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Payment Verification Requests</h6>
                <a asp-action="Settings" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="fas fa-cog mr-1"></i> Payment Settings
                </a>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-custom table-hover">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                    <th>Transaction Ref</th>
                                    <th>Receipt</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="font-weight-bold">@item.ISP_User.Name</div>
                                            <div class="small text-muted">@item.ISP_User.Email</div>
                                        </td>
                                        <td class="font-weight-bold">@item.Amount.ToString("C")</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(item.TransactionReference))
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                            else
                                            {
                                                <span>@item.TransactionReference</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ReceiptPath))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-info btn-view-receipt" data-url="@item.ReceiptPath">
                                                    <i class="fas fa-file-invoice"></i> View
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No receipt</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                                            <div class="small text-muted">@item.CreatedAt.ToString("hh:mm tt")</div>
                                        </td>
                                        <td>
                                            @if (item.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                            else if (item.Status == "Approved")
                                            {
                                                <span class="badge bg-success">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Status == "Pending")
                                            {
                                                <form id="approve-form-@item.Id" asp-action="Approve" asp-route-id="@item.Id" method="post" style="display: inline;">
                                                    <button type="button" class="btn btn-sm btn-success btn-approve" data-id="@item.Id">
                                                        <i class="fas fa-check"></i> Approve
                                                    </button>
                                                </form>
                                                <form id="reject-form-@item.Id" asp-action="Reject" asp-route-id="@item.Id" method="post" style="display: inline;">
                                                    <button type="button" class="btn btn-sm btn-danger btn-reject" data-id="@item.Id">
                                                        <i class="fas fa-times"></i> Reject
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Processed @item.ProcessedAt?.ToString("MMM dd")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle fa-2x mb-2"></i>
                        <p class="mb-0">No payment verification requests yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Receipt Preview Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true" data-bs-keyboard="true" data-bs-backdrop="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: 1.5rem; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
            <div class="modal-header bg-light border-0 px-4 pt-4">
                <h5 class="modal-title font-weight-bold" id="receiptModalLabel">
                    <i class="fas fa-file-invoice-dollar text-primary me-2"></i> Payment Receipt
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="receiptModalBody">
                <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Close
                </button>
                <a href="#" id="modalDownloadBtn" class="btn btn-primary rounded-pill px-4" download>
                    <i class="fas fa-download me-1"></i> Download Original
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Move modal to body to avoid z-index/stacking context issues
            $('#receiptModal').appendTo("body");

            $('.btn-approve').click(function () {
                const id = $(this).data('id');
                Swal.fire({
                    title: 'Approve Payment?',
                    text: "This will activate the user's service and send a confirmation notification.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Yes, Approve',
                    background: '#ffffff',
                    customClass: {
                        popup: 'animated fadeInDown faster'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $(`#approve-form-${id}`).submit();
                    }
                });
            });

            $('.btn-reject').click(function () {
                const id = $(this).data('id');
                Swal.fire({
                    title: 'Reject Payment?',
                    text: "The user will be notified that their payment could not be verified.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Yes, Reject',
                    background: '#ffffff',
                    customClass: {
                        popup: 'animated fadeInDown faster'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $(`#reject-form-${id}`).submit();
                    }
                });
            });

            // Receipt Modal Logic
            $('.btn-view-receipt').click(function () {
                const url = $(this).data('url');
                const isPdf = url.toLowerCase().endsWith('.pdf');
                
                $('#modalDownloadBtn').attr('href', url);
                let content = '';
                
                if (isPdf) {
                    content = `<iframe src="${url}" style="width:100%; height:600px; border:none; border-radius: 8px;"></iframe>`;
                } else {
                    content = `<div class="text-center">
                                    <img src="${url}" class="img-fluid" style="border-radius: 12px; max-height: 70vh; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);" />
                               </div>`;
                }
                
                $('#receiptModalBody').html(content);
                $('#receiptModal').modal('show');
            });
        });
    </script>
}
