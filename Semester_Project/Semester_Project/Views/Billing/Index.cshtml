@model List<Semester_Project.Models.ISP_user>

@{
    ViewData["Title"] = "Billing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="h3 mb-4 text-gray-800">Billing & Payments</h1>

<div class="card card-custom shadow mb-4">
    <div class="card-header-custom py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Billing Details</h6>
        <a asp-controller="ISP" asp-action="FixPaymentData" class="btn btn-sm btn-warning shadow-sm">
            <i class="fas fa-wrench fa-sm text-white-50"></i> Fix Data
        </a>
    </div>
    <div class="card-body">
        <!-- Filter Form -->
        <div class="card mb-4 border-left-primary">
            <div class="card-body py-2">
                <form method="get" asp-action="Index" class="form-row align-items-center">
                    <div class="col-auto">
                        <label class="font-weight-bold mr-2"><i class="fas fa-filter text-gray-500"></i> Filter By:</label>
                    </div>
                    <div class="col-auto">
                        <select name="month" class="custom-select custom-select-sm">
                            <option value="">-- All Months --</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(ViewBag.FilterMonth == i)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select name="year" class="custom-select custom-select-sm">
                            <option value="">-- All Years --</option>
                            @for (int i = DateTime.Now.Year; i >= 2023; i--)
                            {
                                <option value="@i" selected="@(ViewBag.FilterYear == i)">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-sm shadow-sm">Apply Filter</button>
                    </div>
                    @if (ViewBag.FilterMonth != null || ViewBag.FilterYear != null)
                    {
                        <div class="col-auto">
                            <a asp-action="Index" class="btn btn-secondary btn-sm shadow-sm">
                                <i class="fas fa-times"></i> Clear
                            </a>
                        </div>
                    }
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-custom table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Package (Mbps)</th>
                        <th>Amount</th>
                        <th>Payment Status</th>
                        <th>Active Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Name</td>
                            <td>
                                @(customer.InternetPackage?.Speed.ToString() ?? "0")
                            </td>
                            <td>
                                @(customer.InternetPackage?.Price.ToString("C") ?? "-")
                            </td>
                            <td>
                                @if (customer.IsPaid == true)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unpaid</span>
                                }
                            </td>
                            <td>
                                @if (customer.IsActive == true)
                                {
                                    <span class="badge bg-primary">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (customer.IsPaid == true)
                                {
                                    <form asp-action="MarkAsUnpaid" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@customer.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm shadow-sm">
                                            <i class="fas fa-times-circle"></i> Mark Unpaid
                                        </button>
                                    </form>
                                    <a asp-action="DownloadInvoice" asp-route-id="@customer.Id" class="btn btn-info btn-sm shadow-sm" target="_blank">
                                        <i class="fas fa-file-pdf"></i> Invoice
                                    </a>
                                }
                                else
                                {
                                    <form asp-action="MarkAsPaid" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@customer.Id" />
                                        <button type="submit" class="btn btn-success btn-sm shadow-sm">
                                            <i class="fas fa-check-circle"></i> Mark Paid
                                        </button>
                                    </form>
                                     <a asp-action="DownloadInvoice" asp-route-id="@customer.Id" class="btn btn-secondary btn-sm shadow-sm disabled">
                                        <i class="fas fa-file-pdf"></i> Invoice
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
