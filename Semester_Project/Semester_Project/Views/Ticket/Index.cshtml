@model List<Semester_Project.Models.SupportTicket>
@{
    ViewData["Title"] = "Support Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Support Tickets</h1>
    <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> New Ticket
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Ticket List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Subject</th>
                        @if (User.IsInRole("Admin")) { <th>User</th> }
                        <th>Remarks</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                    <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td>#@ticket.Id</td>
                            <td>@ticket.CreatedDate.ToShortDateString()</td>
                            <td>@ticket.Subject</td>
                            @if (User.IsInRole("Admin")) { <td>@(ticket.User?.Name ?? "Unknown")</td> }
                            <td class="small">@ticket.Remarks</td>
                            <td>
                                @if (ticket.Status == Semester_Project.Models.TicketStatus.Resolved)
                                {
                                    <span class="badge bg-success">Resolved</span>
                                }
                                else if (ticket.Status == Semester_Project.Models.TicketStatus.Pending)
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Open</span>
                                }
                            </td>
                            <td>
                                @if (User.IsInRole("Admin"))
                                {
                                    if (ticket.Status != Semester_Project.Models.TicketStatus.Resolved)
                                    {
                                        <button type="button" class="btn btn-success btn-sm btn-circle" onclick="toggleResolveForm(@ticket.Id)">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                    <a asp-action="Delete" asp-route-id="@ticket.Id" class="btn btn-danger btn-sm btn-circle" onclick="return confirm('Are you sure?');">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                        @if (User.IsInRole("Admin") && ticket.Status != Semester_Project.Models.TicketStatus.Resolved)
                        {
                            <tr id="resolveForm_@ticket.Id" style="display: none;" class="bg-light">
                                <td colspan="@(User.IsInRole("Admin") ? "7" : "6")">
                                    <form asp-action="MarkResolved" method="post" class="p-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@ticket.Id" />
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Resolution Remarks</label>
                                            <textarea class="form-control" name="remarks" rows="3" required 
                                                      placeholder="Enter details about how the issue was resolved..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="fas fa-check me-1"></i> Mark as Resolved
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="toggleResolveForm(@ticket.Id)">
                                            Cancel
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleResolveForm(ticketId) {
        var form = document.getElementById('resolveForm_' + ticketId);
        if (form.style.display === 'none') {
            form.style.display = 'table-row';
            // Focus on textarea
            var textarea = form.querySelector('textarea');
            if (textarea) {
                setTimeout(function() {
                    textarea.focus();
                }, 100);
            }
        } else {
            form.style.display = 'none';
        }
    }
</script>

