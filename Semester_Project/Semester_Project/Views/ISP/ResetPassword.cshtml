@model Semester_Project.Models.ISP_user

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Reset Password for @Model.Name</h2>

<div class="alert alert-warning">
    <strong>Warning:</strong> This will reset the user's password to the default: <code>User@123</code>.
</div>

<form asp-action="ResetPasswordConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <input type="submit" value="Reset Password" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
