@model Semester_Project.Models.ISP_user

@{
    ViewData["Title"] = "Add Customer";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Customers</h1>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Add New Customer</h6>
            </div>
            <div class="card-body">
                <form method="post" asp-controller="ISP" asp-action="AddUser">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Name" class="form-label">Name</label>
                            <input type="text" id="Name" name="Name" required class="form-control" placeholder="Enter full name" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" id="Email" name="Email" required class="form-control" placeholder="Enter email address" />
                        </div>
                    </div>

                    <div class="row">
                         <div class="col-md-6 mb-3">
                            <label for="Phone" class="form-label">Phone</label>
                            <input type="text" id="Phone" name="Phone" required class="form-control" placeholder="Enter phone number" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="InternetPackageId" class="form-label">Internet Package</label>
                            <select id="InternetPackageId" name="InternetPackageId" class="form-select form-control" required>
                                <option value="">-- Select Package --</option>
                                @foreach (var pkg in ViewBag.Packages as List<Semester_Project.Models.InternetPackage>)
                                {
                                    <option value="@pkg.Id">@pkg.PackageName (@pkg.Speed Mbps) - Rs. @pkg.Price</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Address" class="form-label">Address</label>
                        <input type="text" id="Address" name="Address" required class="form-control" placeholder="Enter full address" />
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("Customers", "ISP")" class="btn btn-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Add Customer</button>
                    </div>
                </form>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-info mt-3" role="alert">
                        @ViewBag.Message
                    </div>
                }
            </div>
        </div>
    </div>
</div>
