@model List<ISP_user>
@{
    ViewData["Title"] = "Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="h3 mb-4 text-gray-800">Customer Management</h1>

<div class="card card-custom shadow mb-4">
    <div class="card-header-custom py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Customers List</h6>
        <div class="dropdown no-arrow">
            <a href="@Url.Action("AddUser", "ISP")" class="btn btn-sm btn-primary-custom shadow-sm">
                <i class="fas fa-plus fa-sm text-white-50"></i> Add Customer
            </a>
            <a asp-controller="InternetPackage" asp-action="Index" class="btn btn-sm btn-info shadow-sm ml-2">
                <i class="fas fa-box fa-sm text-white-50"></i> Manage Packages
            </a>
        </div>
    </div>
    <div class="card-body">
        
        <!-- Search Form -->
        <form method="get" asp-action="Index" class="form-inline mb-4">
            <div class="input-group w-100">
                <input type="text" name="searchString" class="form-control form-control-custom bg-light border-0 small" placeholder="Search for customers..." aria-label="Search" aria-describedby="basic-addon2" value="@ViewData["CurrentFilter"]">
                <div class="input-group-append">
                    <button class="btn btn-primary-custom" type="button">
                        <i class="fas fa-search fa-sm"></i>
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-custom table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Package</th>
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("SupportAgent"))
                        {
                            <th>Price</th>
                        }
                        <th>Expires In</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td>@customer.Name</td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>@customer.Address</td>
                            <td class="text-center">
                                @(customer.InternetPackage?.Speed.ToString() ?? "0") Mbps
                            </td>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("SupportAgent"))
                            {
                                <td>
                                    @(customer.Price.ToString("C"))
                                </td>
                            }
                            <td>
                                @if (customer.IsPaid == true && customer.PackageExpiryDate.HasValue)
                                {
                                    var expiry = customer.PackageExpiryDate.Value;
                                    var daysLeft = (expiry - DateTime.Today).Days;
                                    
                                    <div>
                                        <small class="text-muted">@expiry.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    
                                    if (daysLeft < 0)
                                    {
                                        <span class="badge badge-danger">Expired (@Math.Abs(daysLeft) days ago)</span>
                                    }
                                    else if (daysLeft <= 5)
                                    {
                                        <span class="badge badge-warning">@daysLeft Days Left</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">@daysLeft Days Left</span>
                                    }
                                }
                                else if (customer.IsPaid == true)
                                {
                                    <span class="text-muted">No Date</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Unpaid</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("EditCustomer", "ISP", new { id = customer.Id })" class="btn btn-warning btn-sm btn-circle" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("ResetPassword", "ISP", new { id = customer.Id })" class="btn btn-secondary btn-sm btn-circle" title="Reset Password">
                                    <i class="fas fa-key"></i>
                                </a>
                                <a href="@Url.Action("Delete", "ISP", new { id = customer.Id })" class="btn btn-danger btn-sm btn-circle" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
