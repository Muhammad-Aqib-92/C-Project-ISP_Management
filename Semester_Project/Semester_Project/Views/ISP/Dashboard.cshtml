@model Semester_Project.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="h3 mb-4 text-gray-800">Dashboard</h1>

<div class="row">
    <!-- Earnings (Monthly) Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card card-custom border-left-primary h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Total Customers
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalCustomers</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Earnings (Monthly) Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card card-custom border-left-success h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Total Revenue
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.TotalRevenue</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Warnings Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card card-custom border-left-warning h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Unpaid Customers
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.UnpaidCustomers</div>
                    </div>
                     <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

     <!-- Profit Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card card-custom border-left-info h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Net Profit
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.Profit</div>
                    </div>
                     <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">

    <!-- Recent Customers -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Recent Customers</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Package</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.RecentCustomers)
                            {
                                <tr>
                                    <td>@customer.Name</td>
                                    <td>@(customer.InternetPackage?.PackageName ?? "N/A")</td>
                                    <td>
                                        @if (customer.IsPaid == true)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unpaid</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.RecentCustomers.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No recent customers found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-center mt-3">
                    <a asp-controller="ISP" asp-action="Customers" class="btn btn-sm btn-primary">View All Customers</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Package Popularity -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Package Popularity</h6>
            </div>
            <div class="card-body">
                @foreach (var pkg in Model.PackageDistribution)
                {
                    // Calculate percentage for progress bar (simple estimation based on total count)
                    var total = Model.TotalCustomers > 0 ? Model.TotalCustomers : 1;
                    var percentage = (int)((double)pkg.Value / total * 100);
                    var colorClass = percentage > 50 ? "bg-success" : (percentage > 20 ? "bg-info" : "bg-warning");

                    <h4 class="small font-weight-bold">@pkg.Key <span class="float-right text-muted small">(@pkg.Value users)</span></h4>
                    <div class="progress mb-4">
                        <div class="progress-bar @colorClass" role="progressbar" style="width: @percentage%"
                             aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                }
                @if (!Model.PackageDistribution.Any())
                {
                    <p class="text-center text-muted">No package data available.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Chat scripts removed *@
}
