@model Semester_Project.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="h3 mb-4 text-gray-800">Dashboard</h1>

<div class="row">
    <!-- Earnings (Monthly) Card Example -->
    <!-- Earnings (Monthly) Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="ISP" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom border-left-primary shadow h-100 py-2 transform-hover animate__animated animate__fadeInUp">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Customers
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalCustomers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Earnings (Monthly) Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card card-custom border-left-success h-100 py-2 animate__animated animate__fadeInUp" style="animation-delay: 0.1s">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Total Revenue
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.TotalRevenue</div>
                    </div>
                    <div class="col-auto">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Warnings Card Example -->
    <!-- Warnings Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="ISP" asp-action="Index" asp-route-status="unpaid" class="text-decoration-none">
            <div class="card card-custom border-left-danger shadow h-100 py-2 transform-hover animate__animated animate__fadeInUp" style="animation-delay: 0.2s">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Unpaid Customers
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.UnpaidCustomers</div>
                        </div>
                         <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Paid Customer Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="ISP" asp-action="Index" asp-route-status="paid" class="text-decoration-none">
            <div class="card card-custom border-left-success shadow h-100 py-2 transform-hover animate__animated animate__fadeInUp" style="animation-delay: 0.3s">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Paid Customers
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PaidCustomers</div>
                        </div>
                         <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @if (User.IsInRole("SuperAdmin"))
    {
        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-custom border-left-success h-100 py-2 animate__animated animate__fadeInUp" style="animation-delay: 0.4s">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Revenue (Monthly)
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.TotalRevenue</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profit Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-custom border-left-info h-100 py-2 animate__animated animate__fadeInUp" style="animation-delay: 0.5s">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Net Profit
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.Profit</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-xl-6 col-md-12 mb-4">
           <div class="card shadow h-100 py-2">
                <div class="card-body">
                    <h4 class="font-weight-bold text-primary">Welcome, @User.Identity?.Name!</h4>
                    <p>You have access to the ISP Management System. Please select an option from the sidebar to proceed.</p>
                </div>
           </div>
        </div>
    }
    
    <!-- Open Tickets Card Example -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-controller="Ticket" asp-action="Index" class="text-decoration-none">
            <div class="card card-custom border-left-danger shadow h-100 py-2 transform-hover animate__animated animate__fadeInUp" style="animation-delay: 0.6s">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Open Tickets
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.OpenTickets</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ticket-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row">
    @if (User.IsInRole("SuperAdmin"))
    {
    <!-- Revenue Chart -->
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Revenue Overview</h6>

            </div>
            <div class="card-body">
                <div class="chart-area" style="height: 320px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    }
</div>

<div class="row">

    <!-- Recent Customers -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Recent Customers</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Package</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.RecentCustomers)
                            {
                                <tr>
                                    <td>@customer.Name</td>
                                    <td>@(customer.InternetPackage?.PackageName ?? "N/A")</td>
                                    <td>
                                        @if (customer.IsPaid == true)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unpaid</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.RecentCustomers.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No recent customers found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-center mt-3">
                    <a asp-controller="ISP" asp-action="Index" class="btn btn-primary shadow-sm">
                        <i class="fas fa-users fa-sm text-white-50"></i> View All Customers
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Package Popularity -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Package Popularity</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie pt-4 pb-2" style="height: 250px;">
                    <canvas id="packageChart"></canvas>
                </div>
                <div class="mt-4 text-center small">
                    @foreach(var pkg in Model.PackageDistribution)
                    {
                        <span class="mr-2">
                            <i class="fas fa-circle text-primary"></i> @pkg.Key (@pkg.Value)
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global Chart Defaults
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = '#64748b';
        Chart.defaults.scale.grid.borderColor = '#f1f5f9';
        
        // Revenue Chart with Gradient
        var ctxRevenue = document.getElementById("revenueChart").getContext("2d");
        
        // Create Gradient
        var gradientFill = ctxRevenue.createLinearGradient(0, 0, 0, 400);
        gradientFill.addColorStop(0, "rgba(99, 102, 241, 0.4)"); // Primary color high alpha
        gradientFill.addColorStop(1, "rgba(99, 102, 241, 0.0)"); // Primary color transparent

        var revenueChart = new Chart(ctxRevenue, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RevenueMonths)),
                datasets: [{
                    label: "Revenue",
                    tension: 0.4, // Smooth curves
                    backgroundColor: gradientFill,
                    borderColor: "#6366f1", // Primary Color
                    pointRadius: 4,
                    pointBackgroundColor: "#fff",
                    pointBorderColor: "#6366f1",
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: "#6366f1",
                    pointHoverBorderColor: "#fff",
                    pointHitRadius: 10,
                    pointBorderWidth: 2,
                    fill: true, // Fill under the line
                    data: @Html.Raw(Json.Serialize(Model.RevenueAmounts)),
                }],
            },
            options: {
                maintainAspectRatio: false,
                layout: {
                    padding: { left: 10, right: 25, top: 25, bottom: 0 }
                },
                scales: {
                    x: {
                        grid: { display: false, drawBorder: false },
                        ticks: { maxTicksLimit: 7 }
                    },
                    y: {
                        ticks: {
                            maxTicksLimit: 5,
                            padding: 10,
                            callback: function(value) { return '$' + value; }
                        },
                        grid: {
                            color: "#f1f5f9",
                            borderDash: [5, 5],
                            drawBorder: false,
                        }
                    },
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleFont: { size: 13 },
                        bodyFont: { size: 13 },
                        padding: 12,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function(context) { 
                                return '$ ' + context.parsed.y;
                            }
                        }
                    }
                },
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
            }
        });

        // Package Distribution Chart (Doughnut)
        var ctxPie = document.getElementById("packageChart");
        var packageChart = new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.PackageDistribution.Keys)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.PackageDistribution.Values)),
                    backgroundColor: ['#6366f1', '#10b981', '#0ea5e9', '#f59e0b', '#ef4444'],
                    hoverBackgroundColor: ['#4f46e5', '#059669', '#0284c7', '#d97706', '#dc2626'],
                    hoverBorderColor: "#ffffff",
                    borderWidth: 4,
                    hoverOffset: 4
                }],
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                         backgroundColor: '#1e293b',
                         padding: 12,
                         cornerRadius: 8,
                    }
                },
                cutout: '75%',
                animation: {
                    animateScale: true,
                    animateRotate: true
                }
            },
        });
    </script>
}
