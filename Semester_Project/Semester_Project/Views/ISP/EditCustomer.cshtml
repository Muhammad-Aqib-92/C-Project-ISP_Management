@model ISP_user

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Customers</h1>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Edit Customer Details</h6>
            </div>
            <div class="card-body">
                <form asp-action="EditCustomer" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter full name" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="Enter email address" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="Enter phone number" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                             <!-- Address often takes full width, keeping here for grid consistnecy or could move to full width below -->
                             <label asp-for="Address" class="form-label">Address</label>
                             <input asp-for="Address" class="form-control" placeholder="Enter full address" required />
                             <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="InternetPackageId" class="form-label">Internet Package</label>
                            <select asp-for="InternetPackageId" class="form-select form-control" asp-items="@(new SelectList(ViewBag.Packages as List<Semester_Project.Models.InternetPackage>, "Id", "PackageName"))">
                                <option value="">-- Select Package --</option>
                            </select>
                            <span asp-validation-for="InternetPackageId" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("Customers", "ISP")" class="btn btn-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Update Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
